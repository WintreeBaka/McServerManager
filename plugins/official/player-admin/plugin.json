{
  "id": "com.mcsm.player-admin",
  "name": "玩家管理",
  "version": "1.0.0",
  "apiVersion": 1,
  "minManagerVersion": "1.1.1",
  "scope": "global",
  "description": "为选中的服务器提供玩家管理：白名单 / 黑名单（封禁）/ OP 管理员名单，以及在线玩家与已知玩家的踢出、封禁、标题、私信、游戏模式等操作；页面按玩家分行排列，文案可在插件数据目录的 texts.json 中修改。",
  "author": "McServerManager",
  "homepage": "https://github.com/WintreeBaka/McServerManager",
  "license": "MIT",
  "permissions": ["ui.pages", "servers.read", "servers.control", "config.write",
                  "filesystem.data", "network.outbound"],
  "frontend": {
    "entry": "frontend/index.js"
  },
  "backend": {
    "entry": "backend/index.js",
    "runtime": "node",
    "timeoutMs": 20000
  },
  "hooks": ["plugin.install", "plugin.enable", "plugin.disable", "plugin.uninstall",
            "server.afterStart", "server.afterStop"],
  "contributes": {
    "pages": [
      {
        "id": "player-admin",
        "title": "玩家管理",
        "icon": "⚔",
        "subtitle": "白名单 / 黑名单 / OP 名单 与玩家操作"
      }
    ]
  }
}
