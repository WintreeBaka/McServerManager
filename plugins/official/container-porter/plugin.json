{
  "id": "com.mcsm.container-porter",
  "name": "容器搬运工",
  "version": "0.2.0",
  "apiVersion": 1,
  "minManagerVersion": "1.2.0",
  "scope": "global",
  "description": "把选中服务器的 Docker 容器导出成一个 .tar 容器包，或把容器包导入成一台新的服务器（直接加入服务器列表），用于换机或备份迁移。",
  "author": "McServerManager",
  "homepage": "https://github.com/WintreeBaka/McServerManager",
  "license": "MIT",
  "permissions": ["ui.pages", "servers.read", "filesystem.data", "network.outbound"],
  "frontend": {
    "entry": "frontend/index.js"
  },
  "backend": {
    "entry": "backend/index.js",
    "runtime": "node",
    "timeoutMs": 900000
  },
  "hooks": ["plugin.install", "plugin.enable"],
  "contributes": {
    "pages": [
      {
        "id": "import-export",
        "title": "导入与导出",
        "icon": "⇄",
        "subtitle": "容器导出 / 导入，快速搬家"
      }
    ]
  }
}
